{
    "version": 2,
    "builds": [
        {
            "src": "app.py",
            "use": "@vercel/python"
        },
        {
            "src": "*.html",
            "use": "@vercel/static"
        },
        {
            "src": "*.css",
            "use": "@vercel/static"
        },
        {
            "src": "*.jpg",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/(app\\.py|vercel\\.json|requirements\\.txt|\\.env.*|\\.git.*)",
            "status": 404
        },
        {
            "src": "/(admin-login|admin-login\\.html)",
            "status": 302,
            "headers": { "Location": "https://jsm-chamber-cuttack-odisha-30.vercel.app/admin-login.html" }
        },
        {
            "src": "/(admin-dashboard|admin-dashboard\\.html)",
            "status": 302,
            "headers": { "Location": "https://jsm-chamber-cuttack-odisha-30.vercel.app/admin-dashboard.html" }
        },
        {
            "src": "/api/(.*)",
            "dest": "/app.py"
        },
        {
            "src": "/",
            "dest": "/index.html"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/security-dashboard",
            "dest": "/index.html"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}