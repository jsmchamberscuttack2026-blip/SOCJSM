{
    "version": 2,
    "builds": [
        {
            "src": "app.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/(vercel\\.json|requirements\\.txt|\\.env.*|\\.git.*)",
            "status": 404
        },
        {
            "src": "/(.*)",
            "dest": "app.py"
        }
    ]
}
