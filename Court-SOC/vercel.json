{
    "version": 2,
    "builds": [
        {
            "src": "app.py",
            "use": "@vercel/python"
        },
        {
            "src": "*.html",
            "use": "@vercel/static"
        },
        {
            "src": "*.css",
            "use": "@vercel/static"
        },
        {
            "src": "*.jpg",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/(app\\.py|vercel\\.json|requirements\\.txt|\\.env.*|\\.git.*)",
            "status": 404
        },
        {
            "src": "/api/(.*)",
            "dest": "/app.py"
        },
        {
            "src": "/",
            "dest": "/index.html"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/security-dashboard",
            "dest": "/index.html"
        },
        {
            "src": "/admin-login",
            "dest": "/admin-login.html"
        },
        {
            "src": "/admin-dashboard",
            "dest": "/admin-dashboard.html"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}